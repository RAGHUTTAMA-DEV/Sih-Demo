{
  "name": "css-srp-3d-digital-twin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "High-fidelity 3D digital twin simulation of a heavy-oil well (CSS + Sucker Rod Pump). Features mechanical kinematics, wellbore fluid viscosity dynamics, steam injection soaking simulation, and oil flow particles.",
  "author": "Baghewala Field Ops",
  "keywords": [
    "threejs",
    "react-three-fiber",
    "digital-twin",
    "cyclic-steam-stimulation",
    "sucker-rod-pump",
    "oil-flow-simulation",
    "scada"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "demo:oil-flow": "vite --open"
  },
  "dependencies": {
    "@react-three/drei": "^9.106.0",
    "@react-three/fiber": "^8.16.8",
    "canvas-confetti": "^1.9.3",
    "lucide-react": "^0.395.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "three": "^0.165.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.165.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "localtunnel": "^2.0.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  }
}
